# Yalnızca GENEL (public) değerler. Bu değişkenler derlenmiş JavaScript içine gömülür
# ve tarayıcıda herkes tarafından görülebilir. Buraya ASLA service_role anahtarı,
# veritabanı parolası veya yönetici parolası koymayın.

# Supabase proje URL'si (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable / anon anahtarı (RLS ile korunduğu için tarayıcıda olabilir)
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# Cloudflare Turnstile SITE anahtarı (genel). GİZLİ anahtar buraya DEĞİL, Supabase Function
# Secrets'a (TURNSTILE_SECRET_KEY) girilir. Yerel deneme için Cloudflare'in her zaman geçen
# test anahtarı: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=YOUR-TURNSTILE-SITE-KEY

# GitHub Pages taban yolu (İSTEĞE BAĞLI — genellikle boş bırakın).
# Boşsa üretim derlemesi /farukdemiezen.me/ kullanır (vite.config.ts), geliştirme sunucusu "/".
# Yalnızca farklı bir yol gerekirse açın, örn. özel alan adı için:
# VITE_BASE_PATH=/
